<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- VRE - Hussar overhauls the vanilla hussar and brings VEF, so the vanilla hussar taste gains VEF
       effects. loadFolders only loads this folder while VRE - Hussar is active. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/HediffDef[defName="BT_Taste_Hussar"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/HediffDef[defName="BT_Taste_Hussar"]/stages/li/statFactors</xpath>
        <match Class="PatchOperationAdd">
          <xpath>/Defs/HediffDef[defName="BT_Taste_Hussar"]/stages/li/statFactors</xpath>
          <value><VEF_RangeAttackDamageFactor>1.1</VEF_RangeAttackDamageFactor></value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>/Defs/HediffDef[defName="BT_Taste_Hussar"]/stages/li</xpath>
          <value><statFactors><VEF_RangeAttackDamageFactor>1.1</VEF_RangeAttackDamageFactor></statFactors></value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>

</Patch>
