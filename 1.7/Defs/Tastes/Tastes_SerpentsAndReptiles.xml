<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Serpent-folk and reptiles. Each taste is a hediff plus the BloodTasteDef listing the xenotypes that give it; both
       carry MayRequireAnyOf for those xenotypes' mods, so neither loads without one. Effects from a framework
       (SM_ = Big and Small, VEF_ / VEF. = Vanilla Expanded, EBSG_ = EBSG) are only used where every listed mod
       requires that framework. -->

  <HediffDef ParentName="BT_BloodTasteBase" MayRequireAnyOf="RedMattis.LamiasAndOtherSnakes">
    <defName>BT_Taste_Serpent</defName>
    <label>serpent blood</label>
    <description>Cold serpent blood. The drinker needs little food and strikes true, but feels the cold more.</description>
    <stages>
      <li>
        <hungerRateFactor>0.75</hungerRateFactor>
        <statOffsets>
          <ToxicResistance>0.15</ToxicResistance>
          <MeleeHitChance>2</MeleeHitChance>
          <ComfyTemperatureMin>3</ComfyTemperatureMin>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <BloodTastes.BloodTasteDef MayRequireAnyOf="RedMattis.LamiasAndOtherSnakes">
    <defName>BT_Serpent</defName>
    <!-- Lamia, Lamia?, Pythonman, Adderman, Giant Anacondaman, naga, Argent Serpent -->
    <xenotypes>
      <li>LoS_Lamia</li>
      <li>LoS_TrueLamia</li>
      <li>LoS_Snakeman</li>
      <li>LoS_Adderman</li>
      <li>LoS_Anacondaman</li>
      <li>Naga</li>
      <li>LoS_Silver</li>
    </xenotypes>
    <hediff>BT_Taste_Serpent</hediff>
  </BloodTastes.BloodTasteDef>

  <HediffDef ParentName="BT_BloodTasteBase" MayRequireAnyOf="RedMattis.LamiasAndOtherSnakes">
    <defName>BT_Taste_Nagaraj</defName>
    <label>nagaraj blood</label>
    <description>Blood of an ageless serpent king. It carries a strange, steady psychic pressure.</description>
    <stages>
      <li>
        <statOffsets>
          <PsychicSensitivity>0.2</PsychicSensitivity>
          <MentalBreakThreshold>-0.04</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.9</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <BloodTastes.BloodTasteDef MayRequireAnyOf="RedMattis.LamiasAndOtherSnakes">
    <defName>BT_Nagaraj</defName>
    <!-- nagaraj -->
    <xenotypes>
      <li>Nagaraj</li>
    </xenotypes>
    <hediff>BT_Taste_Nagaraj</hediff>
  </BloodTastes.BloodTasteDef>

  <HediffDef ParentName="BT_BloodTasteBase" MayRequireAnyOf="RedMattis.LamiasAndOtherSnakes,pesky.petrikin">
    <defName>BT_Taste_Gorgon</defName>
    <label>gorgon blood</label>
    <description>Blood from a petrifying gaze. The drinker's eyes sharpen and their skin stiffens like stone.</description>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
        </statOffsets>
        <statFactors>
          <AimingDelayFactor>0.85</AimingDelayFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <BloodTastes.BloodTasteDef MayRequireAnyOf="RedMattis.LamiasAndOtherSnakes,pesky.petrikin">
    <defName>BT_Gorgon</defName>
    <!-- Gorgon, petrikin -->
    <xenotypes>
      <li>LoS_Gorgon</li>
      <li>Petrikin</li>
    </xenotypes>
    <hediff>BT_Taste_Gorgon</hediff>
  </BloodTastes.BloodTasteDef>

  <HediffDef ParentName="BT_BloodTasteBase" MayRequireAnyOf="RedMattis.LamiasAndOtherSnakes">
    <defName>BT_Taste_Tiamat</defName>
    <label>tiamat blood</label>
    <description>Blood from one of the VIPER experiments. Venom-thick, armored and furious.</description>
    <stages>
      <li>
        <statOffsets>
          <ToxicResistance>0.25</ToxicResistance>
          <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.15</MeleeDamageFactor>
          <IncomingDamageFactor>0.9</IncomingDamageFactor>
          <SM_AcidDmgMult>0.5</SM_AcidDmgMult>
          <SM_BulletDmgMult>0.85</SM_BulletDmgMult>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <BloodTastes.BloodTasteDef MayRequireAnyOf="RedMattis.LamiasAndOtherSnakes">
    <defName>BT_Tiamat</defName>
    <!-- Tiamat -->
    <xenotypes>
      <li>LoS_ScenarioTiamat</li>
    </xenotypes>
    <hediff>BT_Taste_Tiamat</hediff>
  </BloodTastes.BloodTasteDef>

  <HediffDef ParentName="BT_BloodTasteBase" MayRequireAnyOf="vanillaracesexpanded.saurid,Erin.Rhyaeth,sarg.alphagenes">
    <defName>BT_Taste_Reptile</defName>
    <label>reptile blood</label>
    <description>Sun-warmed reptile blood. The drinker basks in heat and eats sparingly, but dislikes the cold.</description>
    <stages>
      <li>
        <hungerRateFactor>0.85</hungerRateFactor>
        <statOffsets>
          <ComfyTemperatureMax>8</ComfyTemperatureMax>
          <ComfyTemperatureMin>4</ComfyTemperatureMin>
          <MeleeHitChance>2</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <VEF_HeatstrokeBuildupMultiplier>0.6</VEF_HeatstrokeBuildupMultiplier>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <BloodTastes.BloodTasteDef MayRequireAnyOf="vanillaracesexpanded.saurid,Erin.Rhyaeth,sarg.alphagenes">
    <defName>BT_Reptile</defName>
    <!-- saurid, rhy'aeth, drakonori -->
    <xenotypes>
      <li>VRESaurids_Saurid</li>
      <li>ERN_Rhyaeth</li>
      <li>AG_Drakonori</li>
    </xenotypes>
    <hediff>BT_Taste_Reptile</hediff>
  </BloodTastes.BloodTasteDef>

</Defs>
