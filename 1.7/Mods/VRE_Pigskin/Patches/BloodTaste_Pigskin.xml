<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- VRE - Pigskin overhauls the vanilla pigskin and brings VEF, so the vanilla pigskin taste gains VEF
       effects. loadFolders only loads this folder while VRE - Pigskin is active. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/HediffDef[defName="BT_Taste_Pigskin"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/HediffDef[defName="BT_Taste_Pigskin"]/stages/li/statFactors</xpath>
        <match Class="PatchOperationAdd">
          <xpath>/Defs/HediffDef[defName="BT_Taste_Pigskin"]/stages/li/statFactors</xpath>
          <value><VEF_FoodCapacityMultiplier>1.3</VEF_FoodCapacityMultiplier></value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>/Defs/HediffDef[defName="BT_Taste_Pigskin"]/stages/li</xpath>
          <value><statFactors><VEF_FoodCapacityMultiplier>1.3</VEF_FoodCapacityMultiplier></statFactors></value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>

</Patch>
